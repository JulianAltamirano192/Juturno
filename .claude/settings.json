{
  "permissions": {
    "allow": [
      "Bash(./scripts/test.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(mypy:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec api alembic:*)",
      "Bash(docker compose up:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.production)",
      "Read(./backups/**)",
      "Read(**/secrets/**)",
      "Bash(cat .env*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose exec api alembic downgrade:*)",
      "Bash(docker compose -f docker-compose.prod.yml:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-migrations.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh" }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false
  },
  "skillOverrides": {
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "keybindings-help": "off",
    "claude-api": "off",
    "claude-in-chrome": "off",
    "plugin-authoring": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off"
  }
}
