REDIS_URL=redis://redis:6379/0
MP_SECRET_KEY=tu_secreto_de_mercadopago_aqui
# OAuth por tenant (cada negocio conecta su propia cuenta MP — D-012):
MP_MARKETPLACE_CLIENT_ID=tu_client_id_de_la_app
MP_MARKETPLACE_CLIENT_SECRET=tu_client_secret_de_la_app
MP_MARKETPLACE_REDIRECT_URL=https://api.juturno.com/mp/connect/callback
# Generar una vez: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MP_TOKEN_ENCRYPTION_KEY=tu_clave_fernet_aqui
# true = credenciales de prueba (checkout sandbox) | false = credenciales de producción
MP_SANDBOX=true
META_VERIFY_TOKEN=tu_token_de_verificacion_whatsapp_aqui
WHATSAPP_TOKEN=tu_access_token_meta_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
CORS_ORIGINS=["http://localhost:3000"]
SENTRY_DSN=
ENVIRONMENT=development
PUBLIC_BASE_URL=https://juturno.com
